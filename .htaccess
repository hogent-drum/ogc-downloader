# Security headers for the static OGC Builder. Requires Apache mod_headers.
# The <IfModule> guard means the site still loads when mod_headers is unavailable.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://unpkg.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://*.tile.openstreetmap.org https:; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; font-src 'self' data:; worker-src 'self' blob:"

  # Browsers ignore HSTS when this header is received over plain HTTP.
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Do not expose dotfiles or common backup/config files if they end up in this folder.
<IfModule mod_authz_core.c>
  <FilesMatch "(^\.|\.(bak|backup|old|orig|save|swp|env|ini|log|sql|sqlite|sqlite3)$)">
    Require all denied
  </FilesMatch>
</IfModule>
